(export (version E)
  (design
    (source "hjjg.sch")
    (date "")
    (tool "Hardware Pipeline v2 (kicad_netlist.py)")
  )
  (components
    (comp (ref "U1")
      (value "Front-end protection limiter — protects LNA from high-power RF pulses up to +40 dBm")
    )
    (comp (ref "U2")
      (value "Low-noise amplifier — first active stage after preselector, sets system noise figure")
    )
    (comp (ref "U3")
      (value "1st downconverter mixer — converts 2-6 GHz RF to 1300 MHz IF1")
    )
    (comp (ref "U4")
      (value "2nd downconverter mixer — converts 1300 MHz IF1 to 200 MHz IF2")
    )
    (comp (ref "U5")
      (value "IF driver amplifier — provides gain and output drive to ADC in the 2nd IF chain")
    )
    (comp (ref "U6")
      (value "Linear gain block / buffer amp — moderate gain stage for IF chain signal conditioning")
    )
    (comp (ref "U7")
      (value "Wideband RF power splitter — 2-way LO distribution to both receiver channels")
    )
    (comp (ref "U8")
      (value "PLL frequency synthesizer — generates tunable LO1 (3.3-7.3 GHz) and LO2 (1.1 GHz) from 10 MHz reference")
    )
    (comp (ref "Y1")
      (value "VCO for LO1 — generates 4-8 GHz local oscillator signal for 1st downconversion")
    )
    (comp (ref "Y2")
      (value "OCXO reference oscillator — provides ultra-stable 10 MHz frequency reference for PLL and system timing")
    )
    (comp (ref "U9")
      (value "14-bit dual-channel ADC — digitises both IF2 channels simultaneously with LVDS output")
    )
    (comp (ref "U10")
      (value "Digital processing FPGA — performs radar DSP, pulse compression, CFAR detection, and LVDS data output")
    )
    (comp (ref "U11")
      (value "Low-noise LDO regulator — provides clean supply rails for LNAs, mixers, PLLs, and ADCs")
    )
    (comp (ref "J_PWR")
      (value "Supply Connector (synthesised)")
    )
    (comp (ref "GND_STAR")
      (value "Ground Reference")
    )
  )
  (nets
    (net (code 1) (name "GND")
      (property (name "netclass") (value "GND"))
      (node (ref "U1") (pin "GND"))
      (node (ref "GND_STAR") (pin "1"))
      (node (ref "U2") (pin "GND"))
      (node (ref "U3") (pin "GND"))
      (node (ref "U4") (pin "GND"))
      (node (ref "U5") (pin "GND"))
      (node (ref "U6") (pin "GND"))
      (node (ref "U7") (pin "GND"))
      (node (ref "U8") (pin "GND"))
      (node (ref "Y1") (pin "GND"))
      (node (ref "Y2") (pin "GND"))
      (node (ref "U9") (pin "GND"))
      (node (ref "U10") (pin "GND"))
      (node (ref "U11") (pin "GND"))
    )
    (net (code 2) (name "IF_U11_U9")
      (property (name "netclass") (value "RF_50OHM"))
      (node (ref "U11") (pin "OUT"))
      (node (ref "U9") (pin "IN"))
    )
    (net (code 3) (name "IF_U3_U4")
      (property (name "netclass") (value "RF_50OHM"))
      (node (ref "U3") (pin "OUT"))
      (node (ref "U4") (pin "IN"))
    )
    (net (code 4) (name "IF_U4_U11")
      (property (name "netclass") (value "RF_50OHM"))
      (node (ref "U4") (pin "OUT"))
      (node (ref "U11") (pin "IN"))
    )
    (net (code 5) (name "LO_U6_U11")
      (property (name "netclass") (value "RF_50OHM"))
