(export (version E)
  (design
    (source "yhh.sch")
    (date "")
    (tool "Hardware Pipeline v2 (kicad_netlist.py)")
  )
  (components
    (comp (ref "U1")
      (value "Low-noise amplifier per balanced pair arm (2 per channel, 8 total) covering 6-26.5 GHz with high gain and low noise figure")
    )
    (comp (ref "U2")
      (value "Ka-band gain block / driver amplifier per channel (15-45 GHz), used for stages 2 and 3 after the balanced LNA")
    )
    (comp (ref "U3")
      (value "PIN diode limiter for front-end protection (1 per channel, 4 total). Survives +30 dBm, limits output to +15 dBm")
    )
    (comp (ref "U4")
      (value "Ceramic preselector bandpass filter between limiter and LNA (1 per channel, 4 total). Also used as interstage BPF for high-gain stability (4 additional)")
    )
    (comp (ref "U5")
      (value "T/R protection SPDT switch (1 per channel, 4 total). Isolates front-end during TX pulses, < 10 us switching")
    )
    (comp (ref "U6")
      (value "4-way power splitter/combiner for monopulse comparator network. Combines 4 channel outputs into Sum and 3 Delta outputs")
    )
    (comp (ref "U7")
      (value "DC-DC buck converter from +28V MIL bus to +5V rail for LNA and gain block bias supplies")
    )
    (comp (ref "J_PWR")
      (value "Supply Connector (synthesised)")
    )
    (comp (ref "GND_STAR")
      (value "Ground Reference")
    )
  )
  (nets
    (net (code 1) (name "GND")
      (property (name "netclass") (value "GND"))
      (node (ref "U1") (pin "GND"))
      (node (ref "GND_STAR") (pin "1"))
      (node (ref "U2") (pin "GND"))
      (node (ref "U3") (pin "GND"))
      (node (ref "U4") (pin "GND"))
      (node (ref "U5") (pin "GND"))
      (node (ref "U6") (pin "GND"))
      (node (ref "U7") (pin "GND"))
    )
    (net (code 2) (name "RF_U1_U2")
      (property (name "netclass") (value "RF_50OHM"))
      (node (ref "U1") (pin "OUT"))
      (node (ref "U2") (pin "IN"))
    )
    (net (code 3) (name "RF_U2_U4")
      (property (name "netclass") (value "RF_50OHM"))
      (node (ref "U2") (pin "OUT"))
      (node (ref "U4") (pin "IN"))
    )
    (net (code 4) (name "RF_U4_U6")
      (property (name "netclass") (value "RF_50OHM"))
      (node (ref "U4") (pin "OUT"))
      (node (ref "U6") (pin "IN"))
    )
    (net (code 5) (name "RF_U6_U7")
      (property (name "netclass") (value "RF_50OHM"))
      (node (ref "U6") (pin "OUT"))
      (node (ref "U7") (pin "IN"))
    )
    (net (code 6) (name "VCC")
      (property (name "netclass") (value "POWER"))
      (node (ref "J_PWR") (pin "1"))
      (node (ref "U1") (pin "VCC"))
      (node (ref "U2") (pin "VCC"))
      (node (ref "U3") (pin "VCC"))
      (node (ref "U4") (pin "VCC"))
      (node (ref "U5") (pin "VCC"))
      (node (ref "U6") (pin "VCC"))
      (node (ref "U7") (pin "VCC"))
    )
  )
)
